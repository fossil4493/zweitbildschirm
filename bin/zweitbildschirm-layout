#!/usr/bin/env python3
"""Hält die Bildschirm-Anordnung stabil, solange das Tablet verbunden ist.

GNOME merkt sich Anordnungen in ~/.config/monitors.xml je Kombination von Monitoren.
Der virtuelle Monitor des Tablets bekommt aber bei jeder Verbindung eine neue
Seriennummer – die Kombination ist also jedes Mal neu, und GNOME setzt ALLE
Monitore (auch Laptop und externe) auf Standardwerte zurück.

Dieses Skript speichert die Anordnung je Kombination der *echten* Monitore
(Tablet ausgenommen) und stellt sie wieder her:
  1. eigene gespeicherte Anordnung (inkl. Tablet), sonst
  2. GNOMEs gespeicherte Anordnung der echten Monitore aus monitors.xml,
     Tablet links daneben.

  zweitbildschirm-layout merken   aktuelle Anordnung speichern
  zweitbildschirm-layout anwenden einmalig anwenden
  zweitbildschirm-layout watch    beobachten: Tablet neu -> anwenden, Änderung -> merken
"""
import json, os, sys
import xml.etree.ElementTree as ET
import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

CFG = os.path.expanduser("~/.config/zweitbildschirm-layout.json")
MONITORS_XML = os.path.expanduser("~/.config/monitors.xml")
BUS, PATH, IFACE = "org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig", "org.gnome.Mutter.DisplayConfig"
TABLET_SCALE = 2.0


def proxy():
    return Gio.DBusProxy.new_for_bus_sync(Gio.BusType.SESSION, 0, None, BUS, PATH, IFACE, None)


def state(p):
    serial, monitors, logical, _props = p.call_sync("GetCurrentState", None, 0, -1, None).unpack()
    return serial, monitors, logical


def is_virtual(spec):
    return spec[0].startswith("Meta-")


def spec_id(spec):
    return "|".join(spec[:4])  # connector|vendor|product|serial


def load_cfg():
    try:
        cfg = json.load(open(CFG))
    except (OSError, ValueError):
        cfg = {}
    if "layouts" not in cfg:  # altes Format (nur Tablet relativ zum Hauptbildschirm)
        cfg = {"layouts": {}, "tablet_default": cfg if "dx" in cfg else None}
    return cfg


def save_cfg(cfg):
    tmp = CFG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=1)
    os.replace(tmp, CFG)


class Lage:
    """Aktueller Zustand, aufbereitet."""

    def __init__(self, p):
        self.serial, monitors, self.logical = state(p)
        self.modes = {}  # connector -> (mode_id, w, h, scales)
        for spec, modes, _props in monitors:
            for m in modes:
                if m[6].get("is-current"):
                    self.modes[spec[0]] = (m[0], m[1], m[2], list(m[5]))
        self.virt = None
        self.phys = []
        for lm in self.logical:
            if any(is_virtual(s) for s in lm[5]):
                self.virt = lm
            else:
                self.phys.append(lm)
        self.key = ",".join(sorted(spec_id(s) for lm in self.phys for s in lm[5]))

    def size(self, lm, scale=None):
        _, w, h, _ = self.modes[lm[5][0][0]]
        sc = scale or lm[2]
        if lm[3] in (1, 3, 5, 7):  # gedreht
            w, h = h, w
        return round(w / sc), round(h / sc)


def gnome_layout(key):
    """Anordnung der echten Monitore aus monitors.xml, falls GNOME genau diese Kombination kennt."""
    try:
        root = ET.parse(MONITORS_XML).getroot()
    except (OSError, ET.ParseError):
        return None
    for conf in root.findall("configuration"):
        entries = {}
        for lm in conf.findall("logicalmonitor"):
            for m in lm.findall("monitor"):
                s = m.find("monitorspec")
                sid = "|".join(s.find(t).text for t in ("connector", "vendor", "product", "serial"))
                entries[sid] = {
                    "x": int(lm.find("x").text), "y": int(lm.find("y").text),
                    "scale": float(lm.find("scale").text),
                    "primary": (lm.findtext("primary") == "yes"),
                }
        if ",".join(sorted(entries)) == key:
            return entries
    return None


def nearest(scale, allowed):
    return scale if scale in allowed else min(allowed, key=lambda s: abs(s - scale))


def overlaps(a, b):
    return a[0] < b[0] + b[2] and b[0] < a[0] + a[2] and a[1] < b[1] + b[3] and b[1] < a[1] + a[3]


def plan(lage, cfg):
    """Ziel-Anordnung: Liste (lm, x, y, scale, primary) oder None."""
    stored = cfg["layouts"].get(lage.key)
    base = stored["phys"] if stored else gnome_layout(lage.key)
    out = []
    for lm in lage.phys:
        sid = spec_id(lm[5][0])
        e = base.get(sid) if base else None
        if e:
            sc = nearest(e["scale"], lage.modes[lm[5][0][0]][3])
            out.append([lm, e["x"], e["y"], sc, e["primary"]])
        else:
            out.append([lm, lm[0], lm[1], lm[2], lm[4]])
    if not any(o[4] for o in out) and out:
        out[0][4] = True

    if lage.virt:
        vscales = lage.modes[lage.virt[5][0][0]][3]
        if stored and "tablet" in stored:
            t = stored["tablet"]
            vs = nearest(t["scale"], vscales)
            out.append([lage.virt, t["x"], t["y"], vs, False])
        else:
            vs = nearest((cfg.get("tablet_default") or {}).get("scale", TABLET_SCALE), vscales)
            tw, th = lage.size(lage.virt, vs)
            rects = [(o[1], o[2]) + lage.size(o[0], o[3]) for o in out]
            prim = next(o for o in out if o[4])
            pw, ph = lage.size(prim[0], prim[3])
            cand = (prim[1] - tw, prim[2] + ph - th, tw, th)  # links vom Hauptbildschirm, unten bündig
            if any(overlaps(cand, r) for r in rects):
                left = min(rects, key=lambda r: r[0])  # sonst links vom äußersten Monitor
                cand = (left[0] - tw, left[1] + left[3] - th, tw, th)
            out.append([lage.virt, cand[0], cand[1], vs, False])
    return out


def anwenden(p, cfg=None):
    cfg = cfg or load_cfg()
    lage = Lage(p)
    if not lage.virt:
        return False
    out = plan(lage, cfg)
    cur = sorted((lm[0], lm[1], lm[2], lm[4]) for lm in lage.logical)
    mx, my = min(o[1] for o in out), min(o[2] for o in out)
    want = sorted((o[1] - mx, o[2] - my, o[3], o[4]) for o in out)
    if cur == want:
        return True
    lms = [(o[1] - mx, o[2] - my, o[3], o[0][3], o[4],
            [(s[0], lage.modes[s[0]][0], {}) for s in o[0][5]]) for o in out]
    args = GLib.Variant("(uua(iiduba(ssa{sv}))a{sv})", (lage.serial, 1, lms, {}))
    try:
        p.call_sync("ApplyMonitorsConfig", args, 0, -1, None)
    except GLib.Error as e:
        print("Anwenden fehlgeschlagen:", e.message, file=sys.stderr)
        return False
    return True


def merken(p=None, quiet=False):
    p = p or proxy()
    lage = Lage(p)
    if not lage.virt:
        if quiet:
            return
        sys.exit("Tablet-Monitor ist gerade nicht verbunden.")
    cfg = load_cfg()
    entry = {"phys": {spec_id(lm[5][0]): {"x": lm[0], "y": lm[1], "scale": lm[2], "primary": lm[4]}
                      for lm in lage.phys},
             "tablet": {"x": lage.virt[0], "y": lage.virt[1], "scale": lage.virt[2]}}
    cfg["layouts"][lage.key] = entry
    cfg["tablet_default"] = {"scale": lage.virt[2]}
    save_cfg(cfg)
    if not quiet:
        print("Gespeichert für:", lage.key.replace(",", " + "))


def watch():
    """Tablet neu oder andere Monitore angesteckt -> gespeicherte Anordnung anwenden;
    Änderung bei gleicher Kombination (z. B. in den Einstellungen) -> merken."""
    p = proxy()
    loop = GLib.MainLoop()
    pending = [None]
    seen = [None]  # (Seriennummer Tablet-Monitor, Kombination echter Monitore)

    def current_virtual():
        lage = Lage(p)
        return (lage.virt[5][0][3], lage.key) if lage.virt else None

    def later():
        pending[0] = None
        v = current_virtual()
        if v is None:
            seen[0] = None
        elif v != seen[0]:
            seen[0] = v
            anwenden(p)
        else:
            merken(p, quiet=True)
        return False

    def on_signal(_p, _sender, name, _params):
        if name == "MonitorsChanged":
            if pending[0] is not None:
                GLib.source_remove(pending[0])
            pending[0] = GLib.timeout_add(1000, later)

    p.connect("g-signal", on_signal)
    seen[0] = current_virtual()
    if seen[0] is not None:
        anwenden(p)
    loop.run()


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "anwenden"
    if cmd == "merken":
        merken()
    elif cmd == "watch":
        watch()
    elif cmd == "plan":  # Diagnose: zeigt, was angewendet würde
        lage = Lage(proxy())
        print("Kombination:", lage.key or "(keine)")
        for o in plan(lage, load_cfg()) if lage.virt else []:
            print(f"  {o[0][5][0][0]:8} x={o[1]} y={o[2]} scale={o[3]} primary={o[4]}")
    else:
        sys.exit(0 if anwenden(proxy()) else 1)
