#!/bin/bash
# Tablet-Zweitbildschirm. Normalerweise nicht nötig: Schalter in den Schnelleinstellungen.
# Nutzung: zweitbildschirm [an|aus|status|einstellungen|freigeben|merken|koppeln]
ADB=~/.local/bin/adb
case "${1:-status}" in
  an|start)  systemctl --user enable --now zweitbildschirm-auto.service; echo "Automatik an.";;
  aus|stop)  systemctl --user disable --now zweitbildschirm-auto.service; echo "Automatik aus, RDP-Server aus.";;
  status)    echo "Automatik: $(systemctl --user is-active zweitbildschirm-auto)"; cat "$XDG_RUNTIME_DIR/zweitbildschirm/state" 2>/dev/null
             echo "RDP-Server: $(systemctl --user is-active gnome-remote-desktop)"; $ADB devices | tail -n +2;;
  einstellungen) gnome-extensions prefs zweitbildschirm@fossil4493.github.io;;
  freigeben) ip=$(awk '/^freigeben/{print $2}' "$XDG_RUNTIME_DIR/zweitbildschirm/state"); [ -n "$ip" ] || ip="$2"
             [ -n "$ip" ] && pkexec /usr/local/libexec/zweitbildschirm-freigabe "$ip" || echo "Keine Freigabe offen (zweitbildschirm freigeben <IP>)";;
  merken)    ~/.local/bin/zweitbildschirm-layout merken;;
  koppeln)   echo "Am Tablet: Entwickleroptionen → Kabelloses Debugging → 'Gerät mit Kopplungscode koppeln'."
             read -rp "IP:Port aus dem Kopplungsdialog: " P; read -rp "Kopplungscode: " C; $ADB pair "$P" "$C";;
  *) echo "Nutzung: $0 [an|aus|status|einstellungen|freigeben|merken|koppeln]"; exit 2;;
esac
